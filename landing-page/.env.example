# Canonical site URL — must match the host that actually serves the site.
# opekit.com 308-redirects to www.opekit.com, so www is the canonical host.
# Used for metadataBase, canonicals, Open Graph, JSON-LD, sitemap.xml and
# robots.txt. A trailing slash is optional — it is stripped automatically.
NEXT_PUBLIC_SITE_URL=https://www.opekit.com
